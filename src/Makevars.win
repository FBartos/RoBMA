CXX_STD = CXX17
OBJECTS = $(ROBMA_OBJECTS)

# Evaluate the JAGS flags once so Windows paths are quoted in the final command.
JAGS_RSCRIPT := "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" --vanilla
JAGS_CPPFLAGS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('CPPFLAGS')")
JAGS_CXXFLAGS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('CXXFLAGS')")
JAGS_LIBS := $(shell $(JAGS_RSCRIPT) -e "rjags::pkg.compile.flags('LIBS')")
JRMATH_LIB = -ljrmath-0

include Makevars.common
