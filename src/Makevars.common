PKG_CPPFLAGS = $(JAGS_CPPFLAGS) -DR_NO_REMAP
PKG_CXXFLAGS = $(JAGS_CXXFLAGS) $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(JAGS_LIBS) $(JRMATH_LIB) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)

ROBMA_OBJECTS = glmm-aghq.o \
		  distributions/DWN.o \
		  distributions/DWB.o \
		  distributions/DWP.o \
		  distributions/DKNOWNVMNORM.o \
		  distributions/DSELNORMSTEP.o \
		  distributions/DSELNORMSTEPSWITCH.o \
		  distributions/DSELNORMKERNEL.o \
		  distributions/DSELNORMMVSTEP.o \
		  distributions/DSELNORMCLUSTERSTEP.o \
		  distributions/DSELNORMFACTORSTEP.o \
		  distributions/DSELNORMSAMPLINGCONDITIONED.o \
		  samplers/CoarseCorrectedSlice.o \
		  samplers/CoarseCorrectedBlock.o \
		  samplers/IndependentBiasJoint.o \
		  samplers/GaussianJoint.o \
		  samplers/JointCluster.o \
		  samplers/CorrectedSampler.o \
		  selnorm/selnorm.o \
		  selnorm/selnorm-mv.o \
		  selnorm/zplot-context.o \
		  r-glmm.o r-known-v.o r-regplot.o r-selnorm.o init.o RoBMA.o testRoBMA.o

###############

all: $(SHLIB)

DISTRIBUTION_OBJECTS = $(filter distributions/%.o,$(OBJECTS))
$(DISTRIBUTION_OBJECTS): %.o: %.h
RoBMA.o: $(DISTRIBUTION_OBJECTS:.o=.h) selnorm/selnorm-mv.h

samplers/CoarseCorrectedSlice.o: samplers/CoarseCorrectedSlice.h samplers/CoarseSurrogate.h samplers/CorrectedSampler.h distributions/DSELNORMMVSTEP.h distributions/DSELNORMCLUSTERSTEP.h distributions/DSELNORMFACTORSTEP.h selnorm/selnorm-mv.h selnorm/selnorm.h selnorm/selnorm-fma.h
samplers/CorrectedSampler.o: samplers/CorrectedSampler.h selnorm/selnorm-mv.h
samplers/CoarseCorrectedBlock.o: samplers/CoarseCorrectedBlock.h samplers/CoarseSurrogate.h samplers/CorrectedSampler.h distributions/DSELNORMMVSTEP.h distributions/DSELNORMCLUSTERSTEP.h distributions/DSELNORMFACTORSTEP.h selnorm/selnorm-mv.h selnorm/selnorm.h selnorm/selnorm-fma.h
RoBMA.o: samplers/CoarseCorrectedSlice.h samplers/CoarseCorrectedBlock.h
RoBMA.o samplers/IndependentBiasJoint.o: samplers/IndependentBiasJoint.h
samplers/IndependentBiasJoint.o: samplers/IndependentBiasProposal.h selnorm/selnorm-tail.h
samplers/IndependentBiasJoint.o samplers/JointCluster.o: distributions/selnorm-jags-bounds.h
RoBMA.o samplers/GaussianJoint.o: samplers/GaussianJoint.h
samplers/GaussianJoint.o: samplers/GaussianJointKernel.h
RoBMA.o samplers/JointCluster.o: samplers/JointCluster.h
RoBMA.o samplers/IndependentBiasJoint.o samplers/GaussianJoint.o samplers/JointCluster.o: samplers/JointSamplerTag.h
samplers/JointCluster.o: selnorm/selnorm.h
r-selnorm.o: samplers/CorrectedSampler.h samplers/CoarseCorrectedBlock.h selnorm/selnorm-mv.h
r-selnorm.o: distributions/DSELNORMCLUSTERSTEP.h distributions/DSELNORMFACTORSTEP.h distributions/selnorm-jags-bounds.h

glmm-aghq.o: glmm-binomial-loglik.h
glmm-aghq.o init.o: glmm-aghq.h

R_GLMM_INC = r-native/r-glmm-common.cc.inc \
			 r-native/r-glmm-marginal.cc.inc

r-glmm.o: $(R_GLMM_INC) glmm-binomial-loglik.h

R_KNOWN_V_INC = r-native/r-known-v-common.cc.inc \
				r-native/r-known-v-plan.cc.inc \
				r-native/r-known-v-low-rank.cc.inc \
				r-native/r-known-v-structured.cc.inc \
				r-native/r-known-v-evaluate.cc.inc

r-known-v.o: $(R_KNOWN_V_INC) selnorm/selnorm-mv.h

R_SELNORM_INC = r-native/r-selnorm-common.cc.inc \
				r-native/r-selnorm-funnel-common.cc.inc \
				r-native/r-selnorm-cluster.cc.inc \
				r-native/r-selnorm-loglik.cc.inc \
				r-native/r-selnorm-mv.cc.inc \
				r-native/r-selnorm-sampling-conditioned.cc.inc \
				r-native/r-selnorm-kernel.cc.inc \
				r-native/r-selnorm-funnel-zcurve.cc.inc

SELNORM_INC = selnorm/selnorm-probability.cc.inc \
			  selnorm/selnorm-step.cc.inc \
			  selnorm/selnorm-phack.cc.inc \
			  selnorm/selnorm-boundary.cc.inc \
			  selnorm/selnorm-api.cc.inc

r-selnorm.o: $(R_SELNORM_INC) selnorm/selnorm.h selnorm/selnorm-mv.h selnorm/selnorm-parallel.h

selnorm/selnorm.o: $(SELNORM_INC) selnorm/selnorm.h

selnorm/selnorm-mv.o distributions/DSELNORMMVSTEP.o distributions/DSELNORMCLUSTERSTEP.o distributions/DSELNORMFACTORSTEP.o: selnorm/selnorm-mv.h selnorm/selnorm.h
selnorm/selnorm-mv.o: selnorm/selnorm-event.cc.inc selnorm/selnorm-sampling-conditioned.cc.inc
selnorm/zplot-context.o: selnorm/zplot-context.h selnorm/selnorm.h selnorm/selnorm-mv.h selnorm/selnorm-compact-partition.h selnorm/selnorm-parallel.h r-native-boundary.h
r-selnorm.o: selnorm/zplot-context.h selnorm/selnorm-compact-partition.h
distributions/DSELNORMSAMPLINGCONDITIONED.o: selnorm/selnorm-mv.h selnorm/selnorm.h

r-regplot.o distributions/DSELNORMSTEP.o distributions/DSELNORMSTEPSWITCH.o distributions/DSELNORMKERNEL.o: selnorm/selnorm.h

$(filter distributions/DSELNORM%.o,$(OBJECTS)): distributions/selnorm-jags-bounds.h distributions/selnorm-node-memo.h

# Local headers are transitive dependencies of the objects that include them.
$(filter distributions/DSELNORM%.o,$(OBJECTS)) r-regplot.o r-selnorm.o selnorm/selnorm.o selnorm/selnorm-mv.o: selnorm/selnorm-fma.h
r-regplot.o r-selnorm.o: plot-root.h
r-selnorm.o selnorm/selnorm.o: selnorm/selnorm-tail.h selnorm/selnorm-tail-kernel.cc.inc
selnorm/selnorm.o: selnorm/selnorm-cdf-table-data.h selnorm/selnorm-node-product.h
selnorm/selnorm-mv.o: selnorm/selnorm-mixture-compression.h selnorm/selnorm-rank-one.h selnorm/selnorm-node-product.h
selnorm/selnorm-mv.o r-selnorm.o $(filter distributions/DSELNORM%.o,$(OBJECTS)): selnorm/selnorm-qmc-z.h

# R API calls and entry boundaries must be rebuilt together.
r-glmm.o r-known-v.o r-regplot.o r-selnorm.o glmm-aghq.o: r-native-api.h r-native-boundary.h
r-selnorm.o: r-native/r-native-probe.cc.inc
